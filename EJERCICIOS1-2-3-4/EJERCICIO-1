package com.mycompany.mavenproject2;
//Desarrollar un programa que permita cargar 5 nombres de personas y sus edades respectivas. Luego de 
//realizar la carga por teclado de todos los datos imprimir los nombres de 
//las personas mayores de edad (mayores o iguales a 18 años
import java.util.Scanner;

public class Mavenproject2 {

    public static void main(String[] args) {
        Scanner teclado = new Scanner(System.in);

        String[] nombres = new String[5];
        int[] edades = new int[5];

        for (int i = 0; i < 5; i++) {
            System.out.print("Ingrese el nombre de la persona "
                    + (i + 1) + ": ");
            nombres[i] = teclado.nextLine();

            System.out.print("Ingrese la edad de "
                    + nombres[i] + ": ");
            edades[i] = teclado.nextInt();
            teclado.nextLine();
        }

        System.out.println("\nPersonas mayores o iguales a 18 años:");

        for (int i = 0; i < 5; i++) {
            if (edades[i] >= 18) {
                System.out.println(nombres[i]);
            }
        }

        teclado.close();
    }
}
